# Copy to .env and fill in. Lines left blank use the default shown.

# --- Claude (required) ------------------------------------------------------
# API key from console.anthropic.com. Used for frame reading + the summary (2 calls per new post).
ANTHROPIC_API_KEY=
# Model for both calls. Default: claude-sonnet-5-5
CLAUDE_MODEL=

# --- Interfaces (set at least one) -------------------------------------------
# Telegram bot token from @BotFather. Use a NEW bot: Telegram allows only one
# poller per token, so sharing a token with another running bot breaks both.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to use the bot. Leave empty, message the bot,
# and it replies with your chat ID to paste here.
TELEGRAM_ALLOWED_CHAT_IDS=
# Bearer token for POST /read. Generate one: openssl rand -hex 32
# Empty = HTTP endpoint disabled (/health still answers).
HTTP_TOKEN=
# Port inside the container. Default: 8080
HTTP_PORT=

# --- Downloading ------------------------------------------------------------
# Netscape-format cookies.txt from a throwaway Instagram account (see README).
# docker-compose mounts ./cookies at /cookies and sets this for you.
# IG_COOKIES=/cookies/cookies.txt
# Seconds allowed for the download step. Default: 120
DOWNLOAD_TIMEOUT=
# Longest video accepted, in seconds. Default: 600
MAX_VIDEO_SECONDS=

# --- Transcription ----------------------------------------------------------
# faster-whisper model: tiny, base, small, medium, large-v3. Default: small
# Downloaded on first use into ./data/models (small is ~480 MB).
WHISPER_MODEL=
# 1 = use OpenAI's Whisper API instead of local faster-whisper (costs ~$0.006/min).
WHISPER_API=0
# Only needed when WHISPER_API=1.
OPENAI_API_KEY=

# --- Processing -------------------------------------------------------------
# Whole-job timeout in seconds. Default: 600
JOB_TIMEOUT=
# Max frames sent to Claude per video. Default: 12
MAX_FRAMES=
# ffmpeg scene-change threshold, 0-1; lower = more frames. Default: 0.3
SCENE_THRESHOLD=

# --- Web address (Traefik) --------------------------------------------------
# Hostname the web page is served at, over HTTPS, by the Traefik already on the VPS.
# Must resolve to the VPS. Default: reels.srv1172913.hstgr.cloud
READER_HOST=
# Docker network Traefik is on, and its certificate resolver name. Defaults match
# Hostinger's n8n template: root_default / mytlschallenge
TRAEFIK_NETWORK=
TRAEFIK_CERTRESOLVER=
